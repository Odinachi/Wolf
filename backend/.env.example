# Required for AI generation: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Sign-in is GitHub and Google only. Set up at least one.
# Callback URL to register with each provider: <WOLF_PUBLIC_URL>/api/auth/<github|google>/callback
#   GitHub:  https://github.com/settings/developers  -> New OAuth App
#   Google:  https://console.cloud.google.com/apis/credentials -> OAuth client ID (Web application)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The URL people open the web app at (the dev server by default).
WOLF_PUBLIC_URL=http://localhost:5173
# Signs OAuth state cookies; set a long random value in production.
WOLF_SECRET_KEY=

# Optional
# WOLF_MODEL=claude-opus-5-5
# WOLF_DATA_DIR=./data                # SQLite database and build artifacts
# WOLF_CORS_ORIGINS=http://localhost:5173
# WOLF_COOKIE_SECURE=false            # set true behind HTTPS
# WOLF_MAX_AGENT_TURNS=30
