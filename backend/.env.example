# Required for AI generation: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Firebase (https://console.firebase.google.com/)
# Sign-in: enable the GitHub and Google providers in Authentication -> Sign-in method.
# The project id is all the backend needs to verify sign-ins.
FIREBASE_PROJECT_ID=
# Storage for build files. Project settings -> Service accounts -> Generate new private key,
# then paste the JSON (or base64 of it) here. Without these, files are kept in WOLF_DATA_DIR.
FIREBASE_STORAGE_BUCKET=            # e.g. your-project.firebasestorage.app
FIREBASE_SERVICE_ACCOUNT=

# Where the web app runs (comma-separated), for CORS.
WOLF_CORS_ORIGINS=http://localhost:5173

# Optional
# WOLF_MODEL=claude-opus-5-5
# WOLF_DATA_DIR=./data              # SQLite database (and local files when storage isn't set)
# WOLF_MAX_AGENT_TURNS=30
# WOLF_DAILY_GENERATION_LIMIT=30     # AI requests per user per 24h (0 = unlimited)
