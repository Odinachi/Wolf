# Required for AI generation, through OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any tool-capable model on https://openrouter.ai/models (default: anthropic/claude-haiku-5.5).
# WOLF_MODEL=anthropic/claude-haiku-5.5   # or anthropic/claude-sonnet-5.5 for higher quality
# Fallback models (comma-separated, in order) when the main model is unavailable or keeps failing.
# WOLF_FALLBACK_MODELS=google/gemini-3-flash-preview

# Firebase (https://console.firebase.google.com/)
# Sign-in: enable the GitHub and Google providers in Authentication -> Sign-in method.
# The project id is all the backend needs to verify sign-ins.
FIREBASE_PROJECT_ID=
# Storage for build files. Project settings -> Service accounts -> Generate new private key,
# then paste the JSON (or base64 of it) here. Without these, files are kept in WOLF_DATA_DIR.
FIREBASE_STORAGE_BUCKET=            # e.g. your-project.firebasestorage.app
FIREBASE_SERVICE_ACCOUNT=

# Pre-launch: "waitlist" shows a waitlist on the site and blocks sign-in for everyone except the
# verified emails below (comma-separated). Use "open" (the default) to let anyone in.
WOLF_ACCESS_MODE=open
WOLF_ALLOWED_EMAILS=

# Where the web app runs (comma-separated), for CORS.
WOLF_CORS_ORIGINS=http://localhost:5173

# Optional
# WOLF_REASONING=on                # set off for models that reject a reasoning effort
# WOLF_DATA_DIR=./data              # SQLite database (and local files when storage isn't set)
# WOLF_MAX_AGENT_TURNS=30
# WOLF_DAILY_GENERATION_LIMIT=30     # AI requests per user per 24h (0 = unlimited)

# Backups (Docker/Railway): continuously replicate the SQLite database to this GCS / Firebase
# Storage bucket with Litestream, using FIREBASE_SERVICE_ACCOUNT. Restores automatically on a fresh volume.
# LITESTREAM_BUCKET=your-project.firebasestorage.app
