# "true" shows sign-in (Log in / Get started). Anything else, or unset, shows "Join waitlist".
# Keep it unset/false in production until launch; set true for local development.
VITE_ALLOW_AUTH=false

# The backend's URL (e.g. your Railway service). Leave empty in development:
# the dev server proxies /api to http://localhost:8000 (or WOLF_API_PORT).
VITE_API_URL=

# Firebase web app config: Firebase console -> Project settings -> Your apps -> Web app.
# These values are public by design.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# The site's public URL, used for absolute social-preview (Open Graph) image links.
VITE_SITE_URL=
